# Configuration Apache de l'hébergement web OVH.
#
# Ce fichier est copié tel quel à la racine du site au build. Il est testé sur
# un vrai Apache par `npm run recette` (voir scripts/apache.mjs) : toute
# modification doit passer ce contrôle avant la mise en ligne.
#
# Les directives inconnues d'Apache provoquent une erreur 500 sur tout le site.
# D'où les blocs <IfModule> : un module absent désactive sa partie, pas le site.
#
# La Content-Security-Policy principale n'est pas ici : Astro la génère page par
# page dans une balise <meta> (astro.config.mjs > experimental.csp), avec
# l'empreinte de chaque script et de chaque style. Seul `frame-ancestors`, qu'une
# balise <meta> ne peut pas porter, est déclaré en en-tête.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/avif .avif
AddType font/woff2 .woff2
AddType text/yaml .yml .yaml
AddCharset utf-8 .html .css .js .mjs .json .xml .txt .yml .yaml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- HTTPS et www ---------------------------------------------------------
  # Une seule adresse fait autorité : https://www.twooldwheels.fr. Les deux
  # tests HTTPS couvrent les deux cas documentés par OVH (%{HTTPS} sur les
  # hébergements mutualisés, %{ENV:HTTPS} sur Cloud Web). Limité au domaine
  # du site pour ne pas rediriger la recette locale ni l'adresse technique OVH.
  # L'adresse visée est reprise de THE_REQUEST, la ligne d'origine envoyée par
  # le navigateur, et non de %{REQUEST_URI} : après la réécriture interne vers
  # contact.html, REQUEST_URI vaut déjà /contact.html et la redirection
  # publiait cette forme-là. La cible est écrite en entier, sinon Apache
  # fabrique l'adresse avec le port et sort un « :443 » inutile.
  RewriteCond %{HTTP_HOST} ^(www\.)?twooldwheels\.fr$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{ENV:HTTPS} !=on
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^\s?]+)
  RewriteRule ^ https://www.twooldwheels.fr%1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^twooldwheels\.fr$ [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s([^\s?]+)
  RewriteRule ^ https://www.twooldwheels.fr%1 [R=301,L]

  # --- Fichiers cachés ------------------------------------------------------
  # L'intégration Git d'OVH dépose un dossier .git dans le répertoire du site :
  # il ne doit jamais être lisible. Seul /.well-known reste accessible (il sert
  # à la validation des certificats).
  RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]

  # --- Anciennes adresses du site Joomla ------------------------------------
  # Relevées dans l'archive Wayback du 15/04/2024 : elles ont été indexées, une
  # 404 perdrait leur historique de référencement. `/galerie-photos`,
  # `/mentions-legales`, `/reparation` et `/vente` existent à l'identique.
  # QSD : les paramètres Joomla (?option=com_...) ne suivent pas la redirection.
  RewriteRule ^contacts/?$ /contact [R=301,L,QSD]
  RewriteRule ^politique-de-protection-des-donnees/?$ /mentions-legales [R=301,L,QSD]
  RewriteRule ^index\.php(/.*)?$ / [R=301,L,QSD]
  RewriteRule ^component(/.*)?$ / [R=301,L,QSD]
  RewriteRule ^feed/?$ / [R=301,L,QSD]

  # Le sitemap s'appelle sitemap-index.xml, mais les outils sondent sitemap.xml.
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

  # --- Une seule forme d'URL : /contact -------------------------------------
  # Astro produit une page par fichier (contact.html, cf. astro.config.mjs) et
  # le site déclare `trailingSlash: 'never'` : canoniques, sitemap et liens
  # disent tous `/contact`. Les autres formes y redirigent.

  # 1. /index.html, /admin/index.html et /contact.html vers leur forme courte.
  #    THE_REQUEST est la ligne envoyée par le navigateur : la règle 3 réécrit
  #    en interne vers contact.html sans jamais repasser par ici.
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/((?:[^?\s]*/)?)index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # 2. /contact/ vers /contact, quand la page existe. Les vrais dossiers
  #    (/admin/) gardent leur « / », qu'Apache ajoute d'office : sans la
  #    condition -d, Apache et cette règle se renverraient la balle à l'infini.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 3. /contact sert contact.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  # --- Sécurité, sur toutes les réponses (y compris 301 et 404) -------------
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  # Sans includeSubDomains ni preload : les sous-domaines éventuels gérés chez
  # OVH (messagerie, redirections) n'ont pas forcément de certificat.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

  # --- Cache ----------------------------------------------------------------
  # Le HTML porte les empreintes CSP des scripts de la page : jamais servi
  # depuis un cache périmé après une mise à jour.
  Header set Cache-Control "public, max-age=0, must-revalidate"

  # Images et polices de /public : elles gardent leur nom d'une version à
  # l'autre, durée modérée.
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Les aperçus de lien (Facebook, LinkedIn, WhatsApp) récupèrent l'image de
  # partage depuis un autre site.
  <Files "og-default.jpg">
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </Files>

  # Deux séries d'en-têtes vivent à côté des fichiers qu'elles visent, pour
  # éviter les blocs <If> : le cache définitif de `/_astro` dans
  # `public/_astro/.htaccess`, la politique de `/admin` dans
  # `public/admin/.htaccess`. Apache les lit après ce fichier, elles l'emportent.
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/yaml text/javascript application/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>
