# En-têtes de la page d'administration (Sveltia CMS).
#
# Ces règles sont ici, et pas dans le .htaccess de la racine, parce qu'y viser ce
# seul dossier demanderait un bloc <If> : une directive refusée par l'hébergeur
# renverrait une erreur 500 sur tout le site, pas seulement sur /admin. Apache
# lit ce fichier après celui de la racine : ce qui est posé ici l'emporte.
<IfModule mod_headers.c>
  # CSP propre à l'administration : base recommandée par Sveltia, plus l'API
  # GitHub. unpkg et 'wasm-unsafe-eval' servent à la conversion des photos en
  # WebP avant l'envoi, dont l'encodeur WebAssembly est chargé à la demande.
  #
  # Connexion par jeton : aucune fenêtre externe, le COOP global convient. Si un
  # jour la connexion passe par le bouton GitHub (OAuth), ajouter ici
  # `Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"` :
  # la fenêtre de connexion renvoie le jeton par window.opener, que same-origin
  # coupe.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://*.githubusercontent.com; media-src blob:; frame-src blob:; connect-src 'self' blob: data: https://unpkg.com https://api.github.com https://www.githubstatus.com; manifest-src blob:; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "public, max-age=0, must-revalidate"
</IfModule>
