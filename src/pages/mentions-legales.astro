---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/ui/Breadcrumb.astro';
import { SITE, LEGAL } from '@/consts';
import { lireReglages, telephoneInternational } from '@/lib/contenu';

const { telephone } = await lireReglages();

// Loi n° 2004-575 du 21 juin 2004 (LCEN), article 6 : pour une personne physique,
// nom, prénom, adresse, téléphone et numéro d'inscription au registre ; nom du
// directeur de la publication ; identité, adresse et téléphone de l'hébergeur.
// Depuis la loi du 14 février 2022, la mention « EI » accompagne le nom.
---

<BaseLayout
  title="Mentions légales"
  description="Mentions légales du site Two Old Wheels, atelier moto à Saint-Martin-d'Uriage."
  canonical="/mentions-legales"
  noindex
  hideCta
>
  <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: 'Mentions légales' }]} />

  <section class="container mx-auto px-4 py-16 max-w-2xl">
    <h1 class="font-display text-4xl text-ink-900 mb-10">Mentions légales</h1>

    <div class="space-y-10 text-ink-700 leading-relaxed">
      <section>
        <h2 class="font-display text-2xl text-ink-900 mb-3">Éditeur</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5">
          <dt class="text-ink-500">Enseigne</dt>
          <dd>{SITE.name}</dd>
          <dt class="text-ink-500">Exploitant</dt>
          <dd>{LEGAL.name}, {LEGAL.form}</dd>
          <dt class="text-ink-500">Adresse</dt>
          <dd>{SITE.address.street}, {SITE.address.postalCode} {SITE.address.city}, France</dd>
          <dt class="text-ink-500">Téléphone</dt>
          <dd>
            <a href={`tel:${telephoneInternational(telephone)}`} class="inline-flex items-center min-h-[44px] -my-2.5 text-rust-500 hover:text-rust-600 underline underline-offset-2">
              {telephone}
            </a>
          </dd>
          <dt class="text-ink-500">Immatriculation</dt>
          <dd>{LEGAL.rcs}</dd>
          <dt class="text-ink-500">SIRET</dt>
          <dd class="tabular-nums">{LEGAL.siret}</dd>
          <dt class="text-ink-500">TVA</dt>
          <dd class="tabular-nums">{LEGAL.vat}</dd>
          <dt class="text-ink-500">Activité</dt>
          <dd>{LEGAL.activity}</dd>
        </dl>
        <p class="mt-4">Directeur de la publication : {LEGAL.name}.</p>
      </section>

      <section>
        <h2 class="font-display text-2xl text-ink-900 mb-3">Hébergement</h2>
        <p>
          {LEGAL.host.name}<br />
          {LEGAL.host.address}<br />
          Téléphone : {LEGAL.host.phone}
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl text-ink-900 mb-3">Données personnelles</h2>
        <p class="mb-3">
          Ce site ne contient aucun formulaire, ne dépose aucun cookie et n'utilise aucun outil de mesure
          d'audience. Les polices sont hébergées sur le site lui-même : aucune donnée n'est transmise à un
          service tiers pendant la navigation.
        </p>
        <p class="mb-3">
          Comme tout hébergeur, {LEGAL.host.name} peut conserver des journaux techniques (adresse IP, date,
          page demandée) pour assurer la sécurité et le bon fonctionnement du service.
        </p>
        <p>
          Les informations que vous me transmettez par téléphone, sur Instagram ou sur Facebook servent
          uniquement à répondre à votre demande et ne sont jamais cédées à des tiers. Vous pouvez demander leur
          consultation ou leur suppression par téléphone ou par courrier à l'adresse ci-dessus.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl text-ink-900 mb-3">Liens externes</h2>
        <p>
          Les liens vers Instagram, Facebook et Google Maps ouvrent des services tiers, soumis à leurs propres
          conditions d'utilisation et politiques de confidentialité.
        </p>
      </section>

      <section>
        <h2 class="font-display text-2xl text-ink-900 mb-3">Propriété intellectuelle</h2>
        <p>
          Les textes, photographies et logo de ce site appartiennent à {LEGAL.name}. Toute reproduction sans
          autorisation est interdite.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
