---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas ou plus."
  noindex
>
  <section class="container mx-auto px-4 py-32 text-center">
    <p class="text-rust-500 font-display text-7xl mb-4">404</p>
    <h1 class="font-display text-3xl text-ink-900 mb-6">Page introuvable</h1>
    <p class="text-ink-700 mb-8">Cette page n'existe pas ou a été déplacée.</p>
    <Button href="/">Retour à l'accueil</Button>
  </section>
</BaseLayout>
