---
/**
 * Visionneuse plein écran pour les photos.
 *
 * Bâtie sur `<dialog>` natif : la fermeture à Échap, le piégeage du focus et
 * le retour du focus sur le déclencheur sont gérés par le navigateur, sans
 * bibliothèque. Aucune dépendance, ce qui compte ici : la CSP du site
 * n'autorise que les scripts empreintés par Astro.
 *
 * Le déclencheur est un `<a data-zoom>` posé en recouvrement de la carte
 * (cf. pages galerie et vente) : la carte garde ses balises `figure` et
 * `figcaption`, tout en devenant cliquable sur toute sa surface. C'est un lien
 * et non un bouton pour que le zoom marche sans JavaScript : il pointe sur
 * l'image, et le script intercepte le clic quand il est disponible.
 *
 * L'image affichée est un clone de celle de la grille, avec `sizes` forcé à
 * 90vw : le navigateur repioche alors la plus grande variante du `srcset`
 * existant, sans requête ni fichier supplémentaire.
 *
 * On doit toujours pouvoir en sortir, et par plusieurs chemins :
 *   - le bouton Fermer, en haut à droite, plein et d'au moins 44 px ;
 *   - un clic n'importe où en dehors de la photo et des commandes ;
 *   - la touche Échap.
 * Sur mobile il n'y a pas d'Échap et le clic à côté est moins évident : c'est
 * pour cela que le bouton est plein et large, pas un simple contour.
 */
---

<dialog
  id="lightbox"
  class="w-full h-full max-w-none max-h-none bg-transparent p-0 backdrop:bg-ink-900/95"
  aria-label="Photo en plein écran"
>
  <div data-lightbox-surface class="flex flex-col h-full w-full gap-3 p-3 sm:gap-4 sm:p-6">
    <div class="flex items-center justify-between gap-3 shrink-0">
      <span id="lightbox-counter" class="font-mono text-xs text-paper-100/60"></span>
      <button
        type="button"
        data-lightbox-close
        class="inline-flex items-center gap-2 min-h-[44px] px-5 bg-rust-500 text-white font-mono text-xs uppercase tracking-wider hover:bg-rust-400 transition-colors duration-200 ease-clack focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-100"
      >
        Fermer
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <div class="flex-1 min-h-0 flex items-center justify-center gap-4">
      <button
        type="button"
        data-lightbox-prev
        aria-label="Photo précédente"
        class="hidden sm:flex shrink-0 w-11 h-11 items-center justify-center text-2xl text-paper-100 border border-paper-100/30 hover:border-rust-400 hover:text-rust-400 transition-colors duration-200 ease-clack"
      >
        <span aria-hidden="true">‹</span>
      </button>

      <figure id="lightbox-frame" class="min-w-0 min-h-0 flex-1 h-full flex items-center justify-center m-0"></figure>

      <button
        type="button"
        data-lightbox-next
        aria-label="Photo suivante"
        class="hidden sm:flex shrink-0 w-11 h-11 items-center justify-center text-2xl text-paper-100 border border-paper-100/30 hover:border-rust-400 hover:text-rust-400 transition-colors duration-200 ease-clack"
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>

    <div class="shrink-0 text-center max-w-2xl mx-auto">
      <span id="lightbox-category" class="block font-mono text-[0.62rem] uppercase tracking-[0.15em] text-rust-400"></span>
      <span id="lightbox-caption" class="block text-sm text-paper-100 mt-1"></span>
      <p class="hidden sm:block font-mono text-[0.62rem] text-paper-100/60 mt-3">
        Échap ou clic à côté pour fermer · flèches du clavier pour naviguer
      </p>
    </div>

    {/* Sur mobile les flèches latérales mangeraient la largeur de la photo :
        elles passent sous la légende, à portée de pouce. */}
    <div class="flex sm:hidden items-center justify-center gap-4 shrink-0">
      <button
        type="button"
        data-lightbox-prev
        aria-label="Photo précédente"
        class="w-16 h-11 flex items-center justify-center text-2xl text-paper-100 border border-paper-100/30"
      >
        <span aria-hidden="true">‹</span>
      </button>
      <button
        type="button"
        data-lightbox-next
        aria-label="Photo suivante"
        class="w-16 h-11 flex items-center justify-center text-2xl text-paper-100 border border-paper-100/30"
      >
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  #lightbox[open] {
    /* `<dialog>` est centré par les marges automatiques du navigateur : on les
       neutralise pour occuper réellement tout l'écran. */
    margin: 0;
    inset: 0;
  }

  #lightbox-frame :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Les photos viennent d'archives en basse définition : un fond clair et un
       filet évitent qu'elles flottent dans le noir. */
    background-color: #f7f2e7;
    border: 3px solid #f7f2e7;
  }
</style>

<script>
  // Les déclencheurs sont les `[data-zoom]` de la page. L'ordre du DOM donne
  // l'ordre de navigation, qui correspond à l'ordre visuel de la grille.
  function initLightbox() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const frame = document.getElementById('lightbox-frame');
    if (!dialog || !frame) return;

    const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-zoom]'));
    if (!triggers.length) return;

    const category = document.getElementById('lightbox-category');
    const caption = document.getElementById('lightbox-caption');
    const counter = document.getElementById('lightbox-counter');
    const single = triggers.length < 2;

    // Deux jeux de flèches coexistent, l'un pour mobile et l'autre pour les
    // écrans larges : d'où `querySelectorAll` et non `querySelector`.
    const prevButtons = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-prev]');
    const nextButtons = document.querySelectorAll<HTMLButtonElement>('[data-lightbox-next]');
    if (single) {
      [...prevButtons, ...nextButtons].forEach((b) => (b.hidden = true));
    }

    // `frame` est capturé ici : le rétrécissement de type de TypeScript ne
    // traverse pas la frontière de la fonction imbriquée.
    const target = frame;
    let current = 0;

    function show(index: number) {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      const source = trigger?.closest('figure')?.querySelector('img');
      if (!trigger || !source) return;

      const clone = source.cloneNode(true) as HTMLImageElement;
      // La grille demande une petite variante (33vw, 25vw…). En plein écran il
      // faut la plus grande du srcset : on le dit au navigateur.
      clone.setAttribute('sizes', '90vw');
      clone.removeAttribute('class');
      clone.removeAttribute('style');
      clone.removeAttribute('data-vt');
      clone.loading = 'eager';

      target.replaceChildren(clone);
      if (category) category.textContent = trigger.dataset.zoomCategory || '';
      if (caption) caption.textContent = source.alt || '';
      if (counter) counter.textContent = single ? '' : `${current + 1} / ${triggers.length}`;
    }

    function close() {
      dialog!.close();
    }

    triggers.forEach((trigger, index) => {
      if (trigger.dataset.bound === 'true') return;
      trigger.dataset.bound = 'true';
      trigger.addEventListener('click', (event) => {
        // Clic milieu ou avec modificateur : on laisse le navigateur ouvrir
        // l'image dans un nouvel onglet, comme pour n'importe quel lien.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        show(index);
        dialog.showModal();
        // Le fond de page ne doit pas défiler derrière la visionneuse.
        document.body.classList.add('overflow-hidden');
      });
    });

    if (dialog.dataset.bound !== 'true') {
      dialog.dataset.bound = 'true';

      document.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
      prevButtons.forEach((b) => b.addEventListener('click', () => show(current - 1)));
      nextButtons.forEach((b) => b.addEventListener('click', () => show(current + 1)));

      // Tout clic qui n'atteint ni la photo ni une commande ferme.
      //
      // Tester `event.target === dialog` ne suffirait pas : le conteneur
      // intérieur couvre toute la surface du dialogue, la cible n'est donc
      // jamais le `<dialog>` lui-même et la fermeture au clic ne se
      // déclencherait jamais.
      dialog.addEventListener('click', (event) => {
        const el = event.target as HTMLElement | null;
        if (!el) return;
        if (el.closest('#lightbox-frame') || el.closest('button')) return;
        close();
      });

      dialog.addEventListener('keydown', (event) => {
        if (single) return;
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + 1);
        }
      });

      // `close` couvre aussi la fermeture par Échap, que `<dialog>` gère seul.
      dialog.addEventListener('close', () => document.body.classList.remove('overflow-hidden'));
    }
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
