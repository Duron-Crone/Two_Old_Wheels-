---
interface Props {
  href: string;
  variant?: 'primary' | 'outline';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;

const base =
  'group inline-flex items-center gap-3 px-8 py-4 text-sm font-bold uppercase tracking-wider transition-all duration-200 ease-clack';
const styles = {
  primary:
    'bg-rust-500 text-white shadow-[6px_6px_0_0_rgba(28,23,18,1)] hover:bg-rust-400 hover:shadow-[8px_8px_0_0_rgba(28,23,18,1)] hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0 active:shadow-[3px_3px_0_0_rgba(28,23,18,1)]',
  outline:
    'border-2 border-ink-900/40 text-ink-700 hover:border-rust-500 hover:text-rust-500 hover:-translate-x-0.5 hover:-translate-y-0.5',
};
---

<a
  href={href}
  class:list={[base, styles[variant]]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  <span aria-hidden="true" class="transition-transform duration-200 ease-clack group-hover:translate-x-1">→</span>
</a>
